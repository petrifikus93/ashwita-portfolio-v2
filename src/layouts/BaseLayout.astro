---
import '../styles/tokens.css';
const { title = 'Ashwita Palekar — Product Designer' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@500&family=Bricolage+Grotesque:wght@300&family=Inter:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="container">
    <slot />
  </div>
</body>
</html>

<style>
  .container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
  }
</style>
